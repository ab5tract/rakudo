$ENV{RAKUDO_HOME} = '@sq_escape(@base_dir@/gen/build_rakudo_home)@';

@if(platform!=windows exec {'@java@'} ('@java@', '-Xss512m', '-Xmx14g', '-XX:+AllowParallelDefineClass', @j_truffle_opts@'-cp', '@sq_escape(@classpath@@j_truffle_jar@)@', 'perl6', @ARGV);)@
@if(platform==windows my $exit = system {'@java@'} ('@java@', '-Xss512m', '-XX:+AggressiveHeap', '-XX:+AllowParallelDefineClass', @j_truffle_opts@'-cp', '@sq_escape(@classpath@@j_truffle_jar@)@', 'perl6', @ARGV);
if ($exit == -1) {
    print STDERR "Failed to execute: $!\n";
    exit(-2);
}
elsif ($exit & 127) {
    printf STDERR "died with signal %d\n", ($? & 127);
    exit(-3);
}
else {
    exit($exit >> 8);
}
)@
