JAVA    = java
JAVAC   = javac
JAR     = jar

# The RakuAST frontend is the only supported one on this branch, and
# src/main.nqp silently falls back to the legacy frontend when the switch
# is missing from the environment. Export it so a bare `make` builds the
# right compiler no matter how it was invoked. GNU make syntax, like the
# rest of this backend's rules.
export RAKUDO_RAKUAST = 1
# The engine build is the build: the encoder and the unit road are on by default (nqp, 2026-09-09).

NQP_PREFIX  = @nqp_prefix@
@bpv(NQP)@       = @shquot(@j_nqp@)@
@bpv(NQP_BIN)@       = @nfp(@j_nqp@)@
# TODO Try to reduce memory usage, https://github.com/rakudo/rakudo/issues/5186
# Overridable: the BOOTSTRAP/CORE compiles OOM'd at the old hardcoded
# -Xmx8G (make J_NQP_MAXHEAP=16G ... to raise further).
J_NQP_MAXHEAP = 14G
# This starts a JVM directly rather than through the nqp runner, so it needs
# the grammar engine spelled out: nqp.jar holds rules compiled to Truffle
# descriptors, and without the modules on the module path and the engine on
# the class path they cannot run at all. Empty when nqp was built without it.
# It also has to name the entry point itself. There is no `nqp` main class in
# a unit-artifact nqp.jar (it holds a unit.meta and no .class at all), so the
# runner enters through UnitMain with the unit path as its first argument --
# the same entry nqp's own runners took in nqp 15c20930c, and one that reads
# a class-road nqp.jar just as happily.
# The same Truffle tier policy the setting compiles run under, for the same
# reason. Every target this drives -- the frontend modules, rakudo.jar and
# the three BOOTSTRAP compiles -- is a process that compiles one file and
# exits, so second-tier compilation has no run left in which to repay
# itself and splitting has no steady state to reach. Milestone 6 measured
# the policy on CORE.c only (434s -> 337s for the tier policy, -> 297s with
# one compiler thread) because rakudo-j-build was the only driver it
# touched; the clean-make breakdown of 2026-09-12 then showed BOOTSTRAP
# v6c at 412s of a 985s build -- the largest single compile in it, and
# running at stock Truffle settings the whole time. The knobs are spelled
# out here rather than folded into j_truffle_args so that the runtime
# runners, where latency mode would be actively wrong, cannot inherit them.
#
# -Xss512m is not optional here, and was missing entirely until now. The
# first run of the policy died with a StackOverflowError 330s into v6c, deep
# in NQP's recursive-descent grammar (quote_atom / EXPR / arglist / fatarrow,
# repeating). The grammar recurses one Java frame chain per rule, so the host
# stack it needs depends on how much of the guest call tree partial evaluation
# has folded away -- and that is precisely what this policy changes. v6c had
# been parsing on the JVM's default stack all along, passing only on headroom
# that second-tier compilation happened to give it. The two other compiler
# drivers already knew this: nqp-j-gradle carries -Xss64m with that very
# comment, rakudo-j-build -Xss512m. This one was the outlier.
#
# With the stack set, the four-point matrix on v6c (standalone, one sample
# each, run-to-run spread under 1%) reads: stock 401s, tier policy 379s,
# tier policy + one compiler thread 381s, one compiler thread alone 398s.
# So on this target the tiering half is the whole effect (-5.5%) and the
# thread cap is inert -- the opposite of CORE.c, where the cap was worth a
# further 40s. The cap is kept regardless: it costs nothing measurable, it
# keeps one policy across both drivers, and it bounds compiler CPU should
# the build ever run in parallel.
#
# The small size of the win is itself the finding. 22s out of 401 says guest
# compilation is a far smaller share of v6c than of CORE.c, and the reason is
# that v6c does not only parse -- it executes a 55k-line BEGIN block, and
# execution is not the workload these knobs make cheaper. Whatever else is in
# v6c's 379s has not been profiled yet.
@bpv(NQP_RR)@    = $(JAVA) -Xss512m -Xmx$(J_NQP_MAXHEAP) -Dpolyglot.engine.Mode=latency -Dpolyglot.engine.FirstTierCompilationThreshold=1600 -Dpolyglot.engine.CompilerThreads=1 @j_truffle_args@ -cp @q(@nfp(./blib)@@cpsep@@nop($(BLD_NQP_JARS))@@cpsep@rakudo-runtime.jar@cpsep@@nop($(SYSROOT))@@abs2rel(@nqp_classpath@)@@j_truffle_jar@)@ org.raku.nqp.runtime.unit.UnitMain @q(@nop($(SYSROOT))@@nfp(@abs2rel(@nqp_classpath@)@/nqp.jar)@)@
@bpv(RUN_RAKUDO_SCRIPT)@ = rakudo-j-build
@bpv(RUN_RAKUDO)@ = @shquot(@perl@)@ @bpm(RUN_RAKUDO_SCRIPT)@

@bpv(DEBUG_RUNNER)@ = rakudo-debug-@backend_abbr@@bpm(RUNNER_SUFFIX)@

NQP_JARS = @nqp_jars@
BLD_NQP_JARS = @bld_nqp_jars@

RUNTIME_SOURCES = @nfp(src/vm/jvm/runtime/org/raku/rakudo/*.java)@ @nfp(src/vm/jvm/runtime/org/raku/rakudo/*.kt)@
RUNTIME_JAR = rakudo-runtime.jar
# The runtime layer is mixed Java/Kotlin; its build lives in
# rakudo-runtime/ and runs on the nested nqp checkout's Gradle wrapper.
GRADLEW = @nfp(nqp/gradlew)@

# The nqp runtime jar every JVM in this build runs on. make must know how
# to rebuild it: editing nqp/src/vm/jvm/runtime/ and running make used to
# build and test against the stale jar in nqp/build/jvm/share, silently.
# $(wildcard) rather than bare globs: a pattern with no matches (there is
# no depth-two .java today) must expand to nothing, not become a literal
# prerequisite make has no rule for. GNU make syntax, like the order-only
# prerequisites below.
NQP_RUNTIME_SOURCES = $(wildcard @nfp(nqp/src/vm/jvm/runtime/org/raku/nqp/*/*.java)@ @nfp(nqp/src/vm/jvm/runtime/org/raku/nqp/*/*.kt)@ @nfp(nqp/src/vm/jvm/runtime/org/raku/nqp/*/*/*.java)@ @nfp(nqp/src/vm/jvm/runtime/org/raku/nqp/*/*/*.kt)@)
NQP_RUNTIME_JAR = @nfp(nqp/build/jvm/share/runtime/nqp-runtime.jar)@

@bpv(BAT)@    = @runner_suffix@

# The directory the Raku-facing VM support code lives under; this backend
# has migrated it from the legacy Perl6/ name.
@bpv(RAKU_VM_DIR)@ = Raku

# This is addition to J_ALL_METAMODEL_SOURCES
@bsv(METAMODEL_SOURCES)@ = @nfp(src/vm/jvm/Raku/Metamodel/JavaHOW.nqp)@

@bpv(ALL_TARGETS)@ = eval-client.pl

@bpv(CLEANUPS)@ = \
  $(RUNTIME_JAR) \
  @bpm(RUN_RAKUDO_SCRIPT)@ \
  rakudo-eval-server \
  perl6-eval-server \
  rakudo-jdb-server \
  perl6-jdb-server \
  eval-client.pl \
  perl6-j \
  perl6-debug-j

@bpv(ML_EXTRA)@ = @nfp(src/vm/jvm/Raku/JavaModuleLoader.nqp)@
# NQP_RUNTIME_JAR sits after the | : order-only, GNU make syntax. The jar
# must be fresh before any build JVM runs on it, but its rebuild (seconds)
# must not timestamp-cascade into a full setting recompile (many minutes)
# -- compiled bytecode does not depend on the runtime that executes it.
@bpv(RAKUDO_DEPS_EXTRA)@ = $(RUNTIME_JAR) | $(NQP_RUNTIME_JAR)

@bpv(NQP_FLAGS_EXTRA)@ = --javaclass=perl6

@bpv(HARNESS_TYPE)@ = 5

# One warm JVM for the whole harness run: --evalserver starts a single
# rakudo-eval-server (8g heap by default, RAKUDO_EVALSERVER_HEAP to
# override; the script refuses to start when that heap plus the live
# servers' headroom exceeds MemAvailable), routes every test file through eval-client, and keeps the
# server alive until the harness exits -- no JVM boot and no re-JIT
# between files, so Truffle compilation actually accumulates over a
# spectest run. Runs serialize on the one server by design; parallel
# pools are tools/build/evalserver-sweep.raku's business.
@bpv(HARNESS5)@ = $(PERL5) @nfp(t/harness5)@ --@backend@ --evalserver

@bsv(SPECIFIC_TEST_DIRS)@ = @nfp(t/03-jvm)@

@include(Makefile-backend-common)@

$(NQP_RUNTIME_JAR): $(NQP_RUNTIME_SOURCES) @nfp(nqp/nqp-runtime/build.gradle.kts)@
	@echo(+++ Generating	$@ (Gradle))@
	$(NOECHO)cd @nfp(nqp)@ && @nfp(../nqp/gradlew)@ --console=plain :nqp-runtime:jar syncRuntimeJars
	@# Gradle leaves the jar untouched when the change was content-neutral
	@# (a bare touch, a comment); bump it so make sees the rule as done
	@# instead of re-running Gradle on every subsequent invocation.
	$(NOECHO)touch $(NQP_RUNTIME_JAR)

$(RUNTIME_JAR): $(RUNTIME_SOURCES) @nfp(rakudo-runtime/build.gradle.kts)@ | $(NQP_RUNTIME_JAR)
	@echo(+++ Generating	$@ (Gradle))@
	$(NOECHO)cd @nfp(rakudo-runtime)@ && @nfp(../nqp/gradlew)@ --console=plain jar
	$(NOECHO)$(CP) @nfp(rakudo-runtime/build/libs/rakudo-runtime.jar)@ $(RUNTIME_JAR)

@bpm(RUN_RAKUDO_SCRIPT)@: @@nfp(@template(@backend_subdir@/rakudo-j-build.in)@)@@
	$(NOECHO)$(RM_F) @q(@bpm(RUN_RAKUDO_SCRIPT)@)@
	$(NOECHO)$(CONFIGURE) --expand @nfpq(@backend_subdir@/@bpm(RUN_RAKUDO_SCRIPT)@)@ --out @bpm(RUN_RAKUDO_SCRIPT)@ \
		--set-var=base_dir=@q($(BASE_DIR))@ \
		--set-var=java=$(JAVA) \
		--set-var=classpath=@q(@nfp(./blib)@@cpsep@@nop($(BLD_NQP_JARS))@@cpsep@rakudo-runtime.jar@cpsep@rakudo.jar@cpsep@@nop($(SYSROOT))@@abs2rel(@nqp_classpath@)@)@

# Milestone 7 Phase C: one training run of the trivial program fills the
# dispatch slots of every artifact it loads (blib/*.jar, rakudo.jar and
# nqp's lib jars). The stamp keeps make's graph honest; the grep is the
# positive marker (a run that wrote nothing fails the build). The run writes
# to the log and the log is shown afterwards, rather than piped through tee:
# make gives each recipe line a plain sh with no pipefail, so a pipeline
# would report tee's status and a trainer that died PART WAY -- after some
# artifacts were rewritten, which the grep cannot tell apart from a whole
# run -- would leave a half-trained build behind, green.
#
# The run rewrites those artifacts in its own order, which is not make's:
# blib/Raku/Actions.jar landing a moment after blib/Raku/Grammar.jar would
# make the next `make` recompile Grammar and everything below it. The
# content changed but nothing went stale, so every rewritten artifact gets
# one and the same mtime back -- make remakes on a STRICTLY newer
# prerequisite -- and the stamp alone is newer than all of them. The trivial
# program never loads 6.e (nor any later spec), so the settings and the
# bootstraps join that one mtime explicitly: training is the last build
# step, and everything the build produced is current as of it.
@bpv(TRAIN_STAMP)@ = @nfp(@bpm(BLIB)@/.dispatch-trained)@

@bpm(TRAIN_STAMP)@: @bsm(RAKUDO)@@for_specs( @bsm(SETTING_@ucspec@)@)@
	@echo(+++ Training	dispatch slots)@
	$(NOECHO)NQP_DISPATCH_RECORD=all @bpm(RUN_RAKUDO)@ -e '' > @nfpq(@bpm(BLIB)@/.dispatch-train.log)@ 2>&1 || { cat @nfpq(@bpm(BLIB)@/.dispatch-train.log)@; exit 1; }
	$(NOECHO)cat @nfpq(@bpm(BLIB)@/.dispatch-train.log)@
	$(NOECHO)grep -q 'dispatch-record: wrote' @nfpq(@bpm(BLIB)@/.dispatch-train.log)@
	$(NOECHO)sed -n 's|^dispatch-record: wrote .* to ||p' @nfpq(@bpm(BLIB)@/.dispatch-train.log)@ | xargs touch -r @nfpq(@bpm(BLIB)@/.dispatch-train.log)@
	$(NOECHO)touch -r @nfpq(@bpm(BLIB)@/.dispatch-train.log)@ @bsm(RAKUDO)@@for_specs( @bsm(SETTING_@ucspec@)@)@ @bpm(RAKUDO_BOOTSTRAP_PRECOMPS)@
	$(NOECHO)touch $@

$(J_RUNNER): @@script(create-jvm-runner.pl)@@@for_specs( @bsm(SETTING_@ucspec@)@)@ @bpm(TRAIN_STAMP)@
	@echo(+++ Setting up	$@)@
	$(NOECHO)$(PERL5) @shquot(@script(create-jvm-runner.pl)@)@ dev @q($(BASE_DIR))@ . . @q(@nqp_home@)@ @q(@static_nqp_home@)@ @q(@static_rakudo_home@)@ @q($(NQP_JARS))@

@backend_prefix@-runner-default: @backend_prefix@-all
	@echo(+++ Setting up @uc(@backend@)@ runner)@
	$(NOECHO)$(CP) $(J_RUNNER) rakudo$(J_BAT)
	$(NOECHO)$(CHMOD) 755 rakudo$(J_BAT)

	@echo(+++ Setting up	$@)@
	$(NOECHO)$(PERL5) @shquot(@script(create-jvm-runner.pl)@)@ dev-debug @q($(BASE_DIR))@ . . @q(@nqp_home@)@ @q(@static_nqp_home@)@ @q(@static_rakudo_home@)@ @q($(NQP_JARS))@

eval-client.pl:
	@echo(+++ Setting up	$@)@
	$(NOECHO)$(CP) @nfpq($(SDKROOT)$(NQP_PREFIX)/bin/eval-client.pl)@ . || $(CP) @nfpq($(SDKROOT)$(NQP_PREFIX)/tools/jvm/eval-client.pl)@ .

##  testing targets

# Run the spectests that we know work.
@backend_prefix@-rakudo_test_run.tar.gz: @backend_prefix@-testable
	- $(J_HARNESS5_WITH_FUDGE) --tests-from-file=$(SPECTEST_DATA) --archive @backend_prefix@-rakudo_test_run.tar.gz

#spectest_smolder: rakudo_test_run.tar.gz
#	./perl6 -e "shell qqx[git log -1 --pretty=format:%H].fmt(qq[curl -F architecture=@cpuarch@ -F platform=@osname@ -F revision=%s -F report_file=@rakudo_test_run.tar.gz -F username=parrot-autobot -F password=qa_rocks http://smolder.parrot.org/app/projects/process_add_report/5])"

# Run the tests in t/localtest.data
@backend_prefix@-localtest: @backend_prefix@-all spectest_update @nfp(t/localtest.data)@
	@$(J_HARNESS5_WITH_FUDGE) --tests-from-file=@nfp(t/localtest.data)@

# Run the tests in t/localtest.data with a higher verbosity
@backend_prefix@-localtest_loud: @backend_prefix@-all spectest_update @nfp(t/localtest.data)@
	@$(J_HARNESS5_WITH_FUDGE) --tests-from-file=@nfp(t/localtest.data)@ --verbosity=1

# Run many tests of your choice.
# make sometests TESTFILES=t/foo/bar
sometests: @backend_prefix@-all
	@$(J_HARNESS5_WITH_FUDGE) $(TESTFILES)

@backend_prefix@-runner-default-install: @backend_prefix@-install @@script(create-jvm-runner.pl)@@
	@echo(+++ Installing @uc(@backend@)@ launcher)@
	$(NOECHO)$(PERL5) @shquot(@script(create-jvm-runner.pl)@)@ install @q($(BASE_DIR))@ @q($(DESTDIR))@ @q($(PREFIX))@ @q(@nqp_home@)@ @q(@static_nqp_home@)@ @q(@static_rakudo_home@)@ @q($(NQP_JARS))@
	$(NOECHO)$(CP) @nfpq($(DESTDIR)$(PREFIX)/bin/rakudo-j$(J_BAT))@ @nfpq($(DESTDIR)$(PREFIX)/bin/rakudo$(J_BAT))@
	$(NOECHO)$(CHMOD) 755 @nfpq($(DESTDIR)$(PREFIX)/bin/rakudo$(J_BAT))@

@backend_prefix@-install-main:: $(RUNTIME_JAR) @@script(create-jvm-runner.pl)@@
	$(NOECHO)$(CP) $(RUNTIME_JAR) @nfpq($(DESTDIR)$(RAKUDO_HOME)/runtime)@
	$(NOECHO)$(PERL5) @shquot(@script(create-jvm-runner.pl)@)@ install @q($(BASE_DIR))@ @q($(DESTDIR))@ @q($(PREFIX))@ @q(@nqp_home@)@ @q(@static_nqp_home@)@ @q(@static_rakudo_home@)@ @q($(NQP_JARS))@
	$(NOECHO)$(PERL5) @shquot(@script(create-jvm-runner.pl)@)@ install-debug @q($(BASE_DIR))@ @q($(DESTDIR))@ @q($(PREFIX))@ @q(@nqp_home@)@ @q(@static_nqp_home@)@ @q(@static_rakudo_home@)@ @q($(NQP_JARS))@

##  cleaning
@backend_prefix@-clean:
	@echo(+++ Cleaning up @uc(@backend@)@)@
	$(NOECHO)$(RM_F) @bpm(CLEANUPS_ALL)@
	$(NOECHO)$(RM_RF) bin

@backend_prefix@-testclean:

