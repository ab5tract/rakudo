use Test;

my $tool = $*PROGRAM.parent(2).add('truffle-trace-summary.raku');
my $fix  = $*PROGRAM.parent.add('fixtures/trace-sample.log');

plan 22;

my $out = run($*EXECUTABLE, $tool, $fix, :out).out.slurp(:close);

ok  $out.contains('done=2'),   'counts the two successful compilations';
ok  $out.contains('failed=6'), 'counts the failed compilations';
nok $out.contains('ok - warm add'),
    'ignores lines that are not engine trace lines';
ok  $out.contains('code installation failed: code is too large'),
    'groups failures by their reason text';
ok  $out ~~ / 'min-too-large-size=900' /,
    'reports the smallest wire size among too-large roots';
ok  $out.contains('parse_expr'),
    'names the roots in the top-roots table';
ok  $out ~~ / 'mean=6500' /,
    'reports the mean time of a reason group in ms';

# Pins the accepted-line count. Without this nothing noticed that a whole
# class of lines had stopped parsing -- which is how the "Reason:" colon in
# TraceCompilationListener.FAILED_FORMAT got through as a silent zero.
ok  $out.contains('events=9'), 'accepts every trace line in the fixture';
ok  $out.contains('unparsed=0'),
    'no [engine] opt line is dropped without a tally';

# FAILED_FORMAT writes "|Reason: %s|" with a colon; DEOPT/INV/UNQUEUED write
# "|Reason %s|" without one. Seven of the nine events carry a reason, and all
# seven must parse -- six with the colon, one without.
ok  $out.contains('reasons-parsed=7'),
    'parses Reason with and without the colon';

# infix:<|> and infix:<+|> are real Rakudo operators, so a root name can
# contain the field separator. The name must survive whole.
ok  $out.contains('infix:<+|>[12345]'),
    'a root name containing | is not split mid-name';

# ... and so can a reason text, because operator names turn up in inlining
# failures. Truncating at the pipe drops the root from the population AND
# defeats the size-bailout match, since a cut reason matches no spelling.
ok  $out.contains('inlining of infix:<+|> failed: code is too large'),
    'a reason text containing | is not truncated at the pipe';

# "code is too large" is not the only spelling of too large: the graph-size
# PermanentBailoutException in libjvmcicompiler.so says "too big to safely
# compile". Both roots must be in the population, in size order.
ok  $out.contains('by size: graph_bail[900], inline_pipe[1500], parse_stmt[48213], parse_expr[91002]'),
    'every spelling of a size bailout joins the population';
ok  $out.contains('too-large roots: 4 (4 sized, 0 unsized)'),
    'shows the population behind the minimum, not just the minimum';

# The part that outlives any list of spellings I can write today: a failure
# reason nobody classified is printed with its size, so a fourth spelling
# shows up named rather than silently leaving the population.
ok  $out.contains('sizes: 700  inlining budget exhausted'),
    'prints unclassified failure reasons with the sizes behind them';

# A loose substring is worse than no spelling at all. "inlining of foo exceeds
# the inlining budget" is a 40-word root reporting an inlining decision, not a
# size bailout; classifying it would set min-too-large-size=40 and a threshold
# of 40 wire words refuses essentially every compilation. It must land in the
# unclassified block instead -- where a human reads it -- and the three
# assertions above (min=900, the by-size line, and the population count) are
# what hold it out of the population.
ok  $out.contains('sizes: 40  inlining of foo exceeds the inlining budget'),
    'an inlining-budget message is unclassified, never a size bailout';

ok  $out.contains('total-compiler-ms=23829'),
    'totals every root';
ok  $out.contains('nqp-root-ms=23757'),
    'totals the bracketed (NQP) roots separately';

# A trace where EVERY failure is an unrecognised spelling: the minimum is
# honestly none, but the reason and its size must still be on screen.
my $unknown = $*PROGRAM.parent.add('fixtures/trace-unknown-bailout.log');
my $out4 = run($*EXECUTABLE, $tool, $unknown, :out).out.slurp(:close);
ok $out4.contains('min-too-large-size=none'),
   'an unrecognised bailout spelling does not invent a minimum';
ok $out4.contains('sizes: 555  graph too chunky for the backend'),
   'an unrecognised bailout spelling is named and sized, never silent';

# A failure whose reason field is named something else must be loud, never a
# bare "none" that Task 4 would read as "nothing was too large".
my $noreason = $*PROGRAM.parent.add('fixtures/trace-noreason.log');
my $out3 = run($*EXECUTABLE, $tool, $noreason, :out).out.slurp(:close);
ok $out3.contains('min-too-large-size=none  (failed=1, reasons-parsed=0)'),
   'says so loudly when failures parsed but their reasons did not';

my $empty = $*PROGRAM.parent.add('fixtures/empty.log');
$empty.spurt('');
my $out2 = run($*EXECUTABLE, $tool, $empty, :out).out.slurp(:close);
ok $out2.contains('min-too-large-size=none'),
   'says none when no root failed for size';
$empty.unlink;
